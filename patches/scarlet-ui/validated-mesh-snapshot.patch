+    #[test]
+    fn validated_canvas_snapshot_does_not_retain_mesh_or_vertices() {
+        let mut encoder = SgfxPaintEncoder::new(32, 32, false).unwrap();
+        let mesh = SgfxMesh::new(triangle(0.0));
+        let vertices = Arc::downgrade(&mesh.vertices);
+        let index = encoder.canvas_mesh(&mesh).unwrap();
+        assert_eq!(Arc::strong_count(&mesh), 1);
+        assert!(
+            encoder.canvas_meshes[index]
+                .validated_snapshot
+                .upgrade()
+                .is_some()
+        );
+        drop(mesh);
+        assert!(
+            encoder.canvas_meshes[index]
+                .validated_snapshot
+                .upgrade()
+                .is_none()
+        );
+        assert!(vertices.upgrade().is_none());
+    }

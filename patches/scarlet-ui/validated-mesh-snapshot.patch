+    #[test]
+    fn canvas_snapshot_revisions_preserve_grow_and_shrink_behavior() {
+        let mut encoder = SgfxPaintEncoder::new(32, 32, false).unwrap();
+        let handle = SgfxMeshHandle::new();
+        let small = SgfxMesh::with_handle(handle, 1, triangle(0.0));
+        let index = encoder.canvas_mesh(&small).unwrap();
+        encoder.canvas_meshes[index].uploaded = true;
+        let original_buffer = encoder.canvas_meshes[index].buffer;
+        let grown = SgfxMesh::with_handle(handle, 2, triangle(1.0).repeat(2));
+        assert_eq!(encoder.canvas_mesh(&grown).unwrap(), index);
+        assert_ne!(encoder.canvas_meshes[index].buffer, original_buffer);
+        assert_eq!(encoder.canvas_meshes[index].capacity_vertices, 8);
+        assert_eq!(encoder.canvas_meshes[index].vertex_count, 6);
+        assert!(!encoder.canvas_meshes[index].uploaded);
+        encoder.canvas_meshes[index].uploaded = true;
+        let grown_buffer = encoder.canvas_meshes[index].buffer;
+        let shrunk = SgfxMesh::with_handle(handle, 3, triangle(2.0));
+        assert_eq!(encoder.canvas_mesh(&shrunk).unwrap(), index);
+        assert_eq!(encoder.canvas_meshes[index].buffer, grown_buffer);
+        assert_eq!(encoder.canvas_meshes[index].capacity_vertices, 8);
+        assert_eq!(encoder.canvas_meshes[index].vertex_count, 3);
+        assert!(!encoder.canvas_meshes[index].uploaded);
+        assert_eq!(encoder.canvas_mesh_validation_count, 3);
+        assert_eq!(encoder.canvas_mesh(&shrunk).unwrap(), index);
+        assert_eq!(encoder.canvas_mesh_validation_count, 3);
+    }

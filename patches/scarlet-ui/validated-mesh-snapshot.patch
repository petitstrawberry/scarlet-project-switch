+    #[test]
+    fn distinct_canvas_snapshots_with_the_same_key_still_validate() {
+        let mut encoder = SgfxPaintEncoder::new(32, 32, false).unwrap();
+        let handle = SgfxMeshHandle::new();
+        let mesh = SgfxMesh::with_handle(handle, 1, triangle(0.0));
+        let index = encoder.canvas_mesh(&mesh).unwrap();
+        encoder.canvas_meshes[index].uploaded = true;
+        let buffer = encoder.canvas_meshes[index].buffer;
+        // Preserve the existing same-revision rule: the first GPU contents/count win.
+        let alias = SgfxMesh::with_handle(handle, 1, triangle(1.0).repeat(2));
+        assert_eq!(encoder.canvas_mesh(&alias).unwrap(), index);
+        assert_eq!(encoder.canvas_mesh_validation_count, 2);
+        assert_eq!(encoder.canvas_meshes[index].buffer, buffer);
+        assert_eq!(encoder.canvas_meshes[index].vertex_count, 3);
+        assert!(encoder.canvas_meshes[index].uploaded);
+        assert_eq!(encoder.canvas_mesh(&alias).unwrap(), index);
+        assert_eq!(encoder.canvas_mesh_validation_count, 2);
+
+        for value in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+            for component in 0..10 {
+                let mut vertices = triangle(0.0);
+                match component {
+                    0..=3 => vertices[0].position[component] = value,
+                    4..=7 => vertices[0].color[component - 4] = value,
+                    _ => vertices[0].tex_coord[component - 8] = value,
+                }
+                let invalid = SgfxMesh::with_handle(handle, 1, vertices);
+                for _ in 0..2 {
+                    assert!(matches!(
+                        encoder.canvas_mesh(&invalid),
+                        Err(Error::InvalidFrame)
+                    ));
+                }
+                let count = encoder.canvas_mesh_validation_count;
+                assert_eq!(encoder.canvas_mesh(&alias).unwrap(), index);
+                assert_eq!(encoder.canvas_mesh_validation_count, count);
+            }
+        }
+        for vertices in [Vec::new(), triangle(0.0)[..2].to_vec()] {
+            let invalid = SgfxMesh::with_handle(handle, 1, vertices);
+            assert!(matches!(
+                encoder.canvas_mesh(&invalid),
+                Err(Error::FrameTooComplex)
+            ));
+        }
+        let count = encoder.canvas_mesh_validation_count;
+        assert_eq!(encoder.canvas_mesh(&alias).unwrap(), index);
+        assert_eq!(encoder.canvas_mesh_validation_count, count);
+        assert_eq!(encoder.canvas_meshes[index].buffer, buffer);
+        assert_eq!(encoder.canvas_meshes[index].vertex_count, 3);
+        assert!(encoder.canvas_meshes[index].uploaded);
+    }

+    #[test]
+    fn failed_canvas_buffer_growth_does_not_commit_validation_snapshot() {
+        let mut encoder = SgfxPaintEncoder::new(32, 32, false).unwrap();
+        let handle = SgfxMeshHandle::new();
+        let mesh = SgfxMesh::with_handle(handle, 1, triangle(0.0));
+        let index = encoder.canvas_mesh(&mesh).unwrap();
+        encoder.canvas_meshes[index].uploaded = true;
+        let buffer = encoder.canvas_meshes[index].buffer;
+        let mut extra_buffers = Vec::new();
+        while let Ok(buffer) = encoder
+            .table
+            .define_buffer(BufferDesc::new(4, BufferUsage::COPY_DST).unwrap())
+        {
+            extra_buffers.push(buffer.id());
+        }
+        let grown = SgfxMesh::with_handle(handle, 2, triangle(1.0).repeat(2));
+        for _ in 0..2 {
+            assert!(matches!(
+                encoder.canvas_mesh(&grown),
+                Err(Error::Sgfx(Stage::DefineResources))
+            ));
+            let cached = &encoder.canvas_meshes[index];
+            assert_eq!(cached.revision, 1);
+            assert_eq!(cached.buffer, buffer);
+            assert_eq!(cached.vertex_count, 3);
+            assert!(cached.uploaded);
+            assert!(cached.validated_snapshot.ptr_eq(&Arc::downgrade(&mesh)));
+        }
+        assert_eq!(encoder.canvas_mesh_validation_count, 3);
+        encoder
+            .table
+            .release_buffer(extra_buffers.pop().unwrap())
+            .unwrap();
+        assert_eq!(encoder.canvas_mesh(&grown).unwrap(), index);
+        assert_eq!(encoder.canvas_mesh_validation_count, 4);
+        assert_eq!(encoder.canvas_meshes[index].revision, 2);
+        assert_eq!(encoder.canvas_meshes[index].vertex_count, 6);
+        assert!(!encoder.canvas_meshes[index].uploaded);
+        assert_eq!(encoder.canvas_mesh(&grown).unwrap(), index);
+        assert_eq!(encoder.canvas_mesh_validation_count, 4);
+    }

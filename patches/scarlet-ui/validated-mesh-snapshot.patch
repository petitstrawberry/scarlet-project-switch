+    #[test]
+    fn failed_canvas_upload_retries_without_revalidating_snapshot() {
+        struct FailOnceMeshExecutor {
+            failed: bool,
+            buffer_write_sizes: Vec<usize>,
+        }
+        impl CommandExecutor for FailOnceMeshExecutor {
+            type Error = &'static str;
+
+            fn execute<'r, 'data>(
+                &mut self,
+                commands: &CommandBuffer<'r, 'data>,
+            ) -> core::result::Result<(), Self::Error> {
+                for command in commands.commands() {
+                    if let Command::WriteBuffer { data, .. } = command {
+                        self.buffer_write_sizes.push(data.len());
+                    }
+                }
+                if !self.failed {
+                    self.failed = true;
+                    Err("injected mesh upload failure")
+                } else {
+                    Ok(())
+                }
+            }
+        }
+        let mut encoder = SgfxPaintEncoder::new(32, 32, false).unwrap();
+        let mesh = SgfxMesh::new(triangle(0.0));
+        let frame = SgfxCanvasFrame::new(1, UiColor::BLACK)
+            .draw(SgfxCanvasDraw::new(mesh, Transform::identity().columns()));
+        let target = encoder.canvas_target(1, 32, 32, false).unwrap();
+        let mut executor = FailOnceMeshExecutor {
+            failed: false,
+            buffer_write_sizes: Vec::new(),
+        };
+        assert!(matches!(
+            encoder.render_canvas(&mut executor, target, &frame),
+            Err(FrameError::Execution("injected mesh upload failure"))
+        ));
+        assert!(!encoder.canvas_meshes[0].uploaded);
+        assert_eq!(encoder.canvas_mesh_validation_count, 1);
+        encoder.discard_frame();
+        encoder
+            .render_canvas(&mut executor, target, &frame)
+            .unwrap();
+        assert!(encoder.canvas_meshes[0].uploaded);
+        assert_eq!(encoder.canvas_mesh_validation_count, 1);
+        assert_eq!(executor.buffer_write_sizes, [120, 120]);
+        encoder.discard_frame();
+        encoder
+            .render_canvas(&mut executor, target, &frame)
+            .unwrap();
+        assert_eq!(encoder.canvas_mesh_validation_count, 1);
+        assert_eq!(executor.buffer_write_sizes, [120, 120]);
+    }

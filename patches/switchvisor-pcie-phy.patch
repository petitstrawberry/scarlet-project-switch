 pub use crate::drivers::usb::tegra210::{CAR, DEV_ASID, PMC};
 pub const LIC: u64 = super::lic::BASE;
 pub const PMC_PAGE: u64 = PMC & !4095;
+pub const PADCTL: u64 = 0x7009_f000;
+
+/// Erista PCIe lane 0 and its P0 PLL are independent from the resident USB2
+/// PHY. The whole PADCTL page remains trapped: shared words use masked RMW
+/// under the USB lock, and USB2, VBUS, SS port and other lane writes stay hidden.
+pub fn pcie_pad_mask(address: u64) -> Option<u32> {
+    match address.checked_sub(PADCTL)? {
+        0x024 => Some(7 << 29), // AUX clamp only; preserve all USB port fields.
+        0x028 => Some((3 << 12) | (1 << 1)), // lane 0 mux and IDDQ disable.
+        0x360 | 0x364 | 0x36c | 0x370 | 0x37c => Some(u32::MAX), // P0 PLL.
+        0x460 | 0x464 => Some(u32::MAX), // PCIe lane 0 electrical controls.
+        _ => None,
+    }
+}
 pub const CONTROLLERS: [(u64, u64); 3] = [
     (0x7009_0000, 0x10000),  // XUSB host and PADCTL.
     (0x700d_0000, 0x10000),  // XUDC, PCI and IPFS.

diff --git a/crates/switchvisor/tests/pcie_phy_ownership.rs b/crates/switchvisor/tests/pcie_phy_ownership.rs
new file mode 100644
--- /dev/null
+++ b/crates/switchvisor/tests/pcie_phy_ownership.rs
@@ -0,0 +1,31 @@
+use switchvisor::vdev::usb_ownership::{self as ownership, PADCTL};
+
+#[test]
+fn pcie_lane_zero_preserves_usb2_and_other_lanes() {
+    // Distinct patterns make an accidental whole-word write visible.
+    let old = 0xa5ff_5a5a;
+    for offset in [0x24, 0x28] {
+        let mask = ownership::pcie_pad_mask(PADCTL + offset).unwrap();
+        for value in [0, u32::MAX, 0x1234_5678] {
+            let next = (old & !mask) | (value & mask);
+            assert_eq!(next & !mask, old & !mask);
+            assert_eq!(next & mask, value & mask);
+        }
+    }
+    assert_eq!(ownership::pcie_pad_mask(PADCTL + 0x24), Some(0xe000_0000));
+    assert_eq!(ownership::pcie_pad_mask(PADCTL + 0x28), Some(0x3002));
+}
+
+#[test]
+fn usb_phy_vbus_and_other_uphy_lanes_remain_inaccessible() {
+    for offset in [0, 4, 8, 0x14, 0x20, 0x80, 0x84, 0x88, 0x8c, 0x284, 0x288,
+                   0x3a0, 0x4a0, 0x4a4, 0x5e0, 0xa60, 0xc60, 0xffc] {
+        assert_eq!(ownership::pcie_pad_mask(PADCTL + offset), None, "{offset:x}");
+        assert!(ownership::controller(PADCTL + offset));
+    }
+    for offset in [0x360, 0x364, 0x36c, 0x370, 0x37c, 0x460, 0x464] {
+        assert_eq!(ownership::pcie_pad_mask(PADCTL + offset), Some(u32::MAX));
+    }
+    assert_eq!(ownership::pcie_pad_mask(PADCTL - 4), None);
+    assert_eq!(ownership::pcie_pad_mask(PADCTL + 0x361), None);
+}
